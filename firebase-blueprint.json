{
  "entities": {
    "Deployment": {
      "title": "Deployment",
      "description": "Represents a cloud infrastructure deployment request and its result.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who requested the deployment." },
        "prompt": { "type": "string", "description": "The natural language description of the infrastructure." },
        "cloud": { "type": "string", "enum": ["azure", "aws", "gcp", "self-hosted"], "description": "The target cloud provider." },
        "language": { "type": "string", "enum": ["bicep", "terraform", "arm", "pulumi", "opentofu", "cloudformation", "cdk", "google-infra-manager", "ansible"], "description": "The IaC language used." },
        "status": { "type": "string", "enum": ["pending", "generating", "validating", "deploying", "success", "failed"], "description": "Current status of the deployment." },
        "plan": { "type": "string", "description": "The structured architecture plan generated by the Planner Agent." },
        "code": { "type": "string", "description": "The generated IaC code." },
        "validation": { "type": "string", "description": "The result of the validation step." },
        "governanceReport": { "type": "object", "description": "Governance and compliance audit report." },
        "driftScan": { "type": "object", "description": "Drift scan results and remediation status." },
        "costEstimate": { "type": "number", "description": "Estimated monthly cost in USD." },
        "costBreakdown": { 
          "type": "array", 
          "items": { 
            "type": "object", 
            "properties": {
              "resource": { "type": "string" },
              "cost": { "type": "number" },
              "unit": { "type": "string" }
            }
          },
          "description": "Detailed resource-level cost breakdown." 
        },
        "diagramCode": { "type": "string", "description": "Mermaid.js code for the architecture diagram." },
        "logs": { "type": "array", "items": { "type": "string" }, "description": "Deployment logs." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of last update." }
      },
      "required": ["userId", "prompt", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile and cloud credentials.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "azureCreds": { "type": "object", "description": "Azure Service Principal details (encrypted or simulated)." },
        "awsCreds": { "type": "object", "description": "AWS IAM details." },
        "gcpCreds": { "type": "object", "description": "GCP Service Account details." }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/deployments/{deploymentId}": {
      "schema": "Deployment",
      "description": "Collection of infrastructure deployments."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and settings."
    }
  }
}
